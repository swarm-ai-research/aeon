        "advisory-status",
        "sep-2",
        "repo-section",
        "sep-3",
        "issues-section"
      ]
    },
    "stats-section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat-triaged",
        "stat-repos",
        "stat-urgent",
        "stat-dupes",
        "stat-needs"
      ]
    },
    "stat-triaged": {
      "type": "Stat",
      "props": {
        "label": "Triaged",
        "value": "1"
      }
    },
    "stat-repos": {
      "type": "Stat",
      "props": {
        "label": "Repos",
        "value": "1"
      }
    },
    "stat-urgent": {
      "type": "Stat",
      "props": {
        "label": "Urgent",
        "value": "0"
      }
    },
    "stat-dupes": {
      "type": "Stat",
      "props": {
        "label": "Duplicates closed",
        "value": "0"
      }
    },
    "stat-needs": {
      "type": "Stat",
      "props": {
        "label": "Needs-info",
        "value": "0"
      }
    },
