      "type": "Badge",
      "props": {
        "text": "1 advisory verdict",
        "variant": "default"
      }
    },
    "repo-badge-access": {
      "type": "Badge",
      "props": {
        "text": "No write access",
        "variant": "outline"
      }
    },
    "repo-memory-link": {
      "type": "StoryLink",
      "props": {
        "title": "memory/triage-advisory/aaronjmars-aeon.md",
