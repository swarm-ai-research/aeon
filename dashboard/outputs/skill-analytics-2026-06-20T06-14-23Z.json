{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Skill Analytics — 2026-06-20"
      },
      "children": [
        "metrics-grid",
        "sep1",
        "critical-section",
        "degraded-section",
        "sep2",
        "topby-section",
        "sep3",
        "full-link"
      ]
    },
    "metrics-grid": {
      "type": "Grid",
      "props": {
        "columns": 5,
        "gap": "md"
      },
      "children": [
        "stat-window",
        "stat-runs",
        "stat-skills",
        "stat-success",
        "stat-anomalies"
      ]
    },
    "stat-window": {
      "type": "Stat",
      "props": {
        "label": "Window",
        "value": "last 7d"
      }
    },
    "stat-runs": {
      "type": "Stat",
      "props": {
        "label": "Total runs",
        "value": "942"
      }
    },
    "stat-skills": {
      "type": "Stat",
      "props": {
        "label": "Skills",
        "value": "38"
      }
    },
    "stat-success": {
      "type": "Stat",
      "props": {
        "label": "Success rate",
        "value": "1.1%"
      }
    },
    "stat-anomalies": {
      "type": "Stat",
      "props": {
        "label": "Anomalies",
        "value": "44"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "critical-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "critical-heading",
        "alert-agi",
        "alert-config",
        "alert-frequency"
      ]
    },
    "critical-heading": {
      "type": "Heading",
      "props": {
        "text": "🔴 Critical",
        "level": "h3"
      }
    },
    "alert-agi": {
      "type": "Alert",
      "props": {
        "title": "agi-tracker",
        "message": "SILENT: scheduled `0 13 * * 1`, zero runs",
        "type": "error"
      }
    },
    "alert-config": {
      "type": "Alert",
      "props": {
        "title": "config-validator",
        "message": "SILENT: scheduled `0 7 * * 0`, zero runs",
        "type": "error"
      }
    },
    "alert-frequency": {
      "type": "Alert",
      "props": {
        "title": "run-frequency-guard",
        "message": "SILENT: scheduled `0 23 * * *` (daily), zero runs",
        "type": "error"
      }
    },
    "degraded-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "degraded-heading",
        "alert-compute",
        "alert-review",
        "alert-health"
      ]
    },
    "degraded-heading": {
      "type": "Heading",
      "props": {
        "text": "🟠 Degraded",
        "level": "h3"
      }
    },
    "alert-compute": {
      "type": "Alert",
      "props": {
        "title": "compute-futures-eda",
        "message": "202-run failure streak",
        "type": "warning"
      }
    },
    "alert-review": {
      "type": "Alert",
      "props": {
        "title": "pr-review",
        "message": "196-run failure streak",
        "type": "warning"
      }
    },
    "alert-health": {
      "type": "Alert",
      "props": {
        "title": "skill-health",
        "message": "195-run failure streak",
        "type": "warning"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "topby-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "topby-heading",
        "topby-list"
      ]
    },
    "topby-heading": {
      "type": "Heading",
      "props": {
        "text": "Top by runs",
        "level": "h3"
      }
    },
    "topby-list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "topby-changelog",
        "topby-code-health",
        "topby-compute"
      ]
    },
    "topby-changelog": {
      "type": "Text",
      "props": {
        "text": "changelog (25)"
      }
    },
    "topby-code-health": {
      "type": "Text",
      "props": {
        "text": "code-health (25)"
      }
    },
    "topby-compute": {
      "type": "Text",
      "props": {
        "text": "compute-futures-eda (25)"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "full-link": {
      "type": "StoryLink",
      "props": {
        "title": "Full analytics report",
        "href": "articles/skill-analytics-2026-06-20.md",
        "source": "skill-analytics"
      }
    }
  }
}
