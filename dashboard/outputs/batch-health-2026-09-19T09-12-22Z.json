    "text_issue_label": {
      "type": "Text",
      "props": {
        "text": "Issue:",
        "variant": "body"
      }
    },
    "link_issue": {
      "type": "Link",
      "props": {
        "label": "ISS-006",
        "href": "#ISS-006"
      }
    },
    "text_history": {
      "type": "Text",
      "props": {
        "text": "Same skills that missed 2026-09-18",
        "variant": "body"
      }
    },
    "text_tuple": {
      "type": "Text",
      "props": {
        "text": "Two daily members of the 4-skill dead-pocket tuple",
        "variant": "body"
      }
    },
    "text_severity_note": {
      "type": "Text",
      "props": {
        "text": "WARN not OUTAGE — memory-flush + memory-structural-dedupe aren't expected on odd DOM",
        "variant": "caption"
      }
    },
    "text_monitoring": {
      "type": "Text",
      "props": {
        "text": "Status: monitoring",
        "variant": "muted"
      }
    }
  }
