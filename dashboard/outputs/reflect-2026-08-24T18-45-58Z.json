    "detail_splits": {
      "type": "Text",
      "props": {
        "text": "Splits: 0",
        "variant": "body"
      }
    },
    "detail_new": {
      "type": "Text",
      "props": {
        "text": "New items: 0",
        "variant": "body"
      }
    },
    "detail_refresh": {
      "type": "Text",
      "props": {
        "text": "MEMORY.md bullets refreshed: 5 post-flush",
        "variant": "body"
      }
    }
