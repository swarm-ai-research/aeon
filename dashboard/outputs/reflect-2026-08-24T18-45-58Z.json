{
  "root": "card_reflect",
  "state": {},
  "elements": {
    "card_reflect": {
      "type": "Card",
      "props": {
        "title": "reflect"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "header_line",
        "metrics_grid",
        "details_section"
      ]
    },
    "header_line": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "badge_status",
        "text_date"
      ]
    },
    "badge_status": {
      "type": "Badge",
      "props": {
        "text": "memory consolidated",
        "variant": "default"
      }
    },
    "text_date": {
      "type": "Text",
      "props": {
        "text": "2026-08-24",
        "variant": "muted"
      }
    },
    "metrics_grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "stat_notes",
        "stat_entries"
      ]
    },
    "stat_notes": {
      "type": "Stat",
      "props": {
        "label": "Notes Added",
        "value": "1",
        "trend": "up"
      }
    },
    "stat_entries": {
      "type": "Stat",
      "props": {
        "label": "Entries Processed",
        "value": "11",
        "trend": "up"
      }
    },
    "details_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "detail_splits",
        "detail_new",
        "detail_refresh"
      ]
