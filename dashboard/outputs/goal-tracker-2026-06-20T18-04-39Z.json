{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Goal Tracker — 2026-06-20",
        "description": "1 goal — 0 at risk, 0 needs attention, 1 on track, 0 blocked, 0 done (new — no prior snapshot)"
      },
      "children": [
        "stats-grid",
        "sep1",
        "ontrack-heading",
        "goal-item",
        "sep2",
        "operator-heading",
        "operator-note",
        "sep3",
        "sources-heading",
        "sources-list"
      ]
    },
    "stats-grid": {
      "type": "Grid",
      "props": {
        "columns": 6,
        "gap": "md"
      },
      "children": [
        "stat-total",
        "stat-risk",
        "stat-attention",
        "stat-ontrack",
        "stat-blocked",
        "stat-done"
      ]
    },
    "stat-total": {
      "type": "Stat",
      "props": {
        "label": "Total Goals",
        "value": "1"
      },
      "children": []
    },
    "stat-risk": {
      "type": "Stat",
      "props": {
        "label": "At Risk",
        "value": "0"
      },
      "children": []
    },
    "stat-attention": {
      "type": "Stat",
      "props": {
        "label": "Needs Attention",
        "value": "0"
      },
      "children": []
    },
    "stat-ontrack": {
      "type": "Stat",
      "props": {
        "label": "On Track",
        "value": "1"
      },
      "children": []
    },
    "stat-blocked": {
      "type": "Stat",
      "props": {
        "label": "Blocked",
        "value": "0"
      },
      "children": []
    },
    "stat-done": {
      "type": "Stat",
      "props": {
        "label": "Done",
        "value": "0"
      },
      "children": []
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "ontrack-heading": {
      "type": "Heading",
      "props": {
        "text": "On Track",
        "level": "h3"
      },
      "children": []
    },
    "goal-item": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "goal-title-row",
        "goal-details-row"
      ]
    },
    "goal-title-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "goal-text",
        "status-badge"
      ]
    },
    "goal-text": {
      "type": "Text",
      "props": {
        "text": "Keep frontier-agent capability tracking accurate via the weekly agi-tracker skill.",
        "variant": "body"
      },
      "children": []
    },
    "status-badge": {
      "type": "Badge",
      "props": {
        "text": "ON TRACK",
        "variant": "default"
      },
      "children": []
    },
    "goal-details-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "detail-idle",
        "detail-activity",
        "detail-new"
      ]
    },
    "detail-idle": {
      "type": "Badge",
      "props": {
        "text": "0d idle",
        "variant": "secondary"
      },
      "children": []
    },
    "detail-activity": {
      "type": "Badge",
      "props": {
        "text": "~10 activity/14d",
        "variant": "secondary"
      },
      "children": []
    },
    "detail-new": {
      "type": "Badge",
      "props": {
        "text": "new",
        "variant": "secondary"
      },
      "children": []
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "operator-heading": {
      "type": "Heading",
      "props": {
        "text": "Operator Note",
        "level": "h3"
      },
      "children": []
    },
    "operator-note": {
      "type": "Alert",
      "props": {
        "message": "rule = ON TRACK (heavy mention activity), but agi-tracker skill has never dispatched (no row in cron-state.json). First weekly slot 2026-06-15 13:00 UTC did not fire. skill-health/skill-analytics/heartbeat all flagged today. No exact \"blocked/stuck on/waiting on\" phrase → BLOCKED rule didn't trigger, but worth investigating.",
        "type": "warning"
      },
      "children": []
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "sources-heading": {
      "type": "Heading",
      "props": {
        "text": "Sources",
        "level": "h3"
      },
      "children": []
    },
    "sources-list": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "source-logs",
        "source-git",
        "source-gh-pr",
        "source-gh-issue",
        "source-cron"
      ]
    },
    "source-logs": {
      "type": "Badge",
      "props": {
        "text": "logs=ok",
        "variant": "secondary"
      },
      "children": []
    },
    "source-git": {
      "type": "Badge",
      "props": {
        "text": "git=ok",
        "variant": "secondary"
      },
      "children": []
    },
    "source-gh-pr": {
      "type": "Badge",
      "props": {
        "text": "gh_pr=ok",
        "variant": "secondary"
      },
      "children": []
    },
    "source-gh-issue": {
      "type": "Badge",
      "props": {
        "text": "gh_issue=ok",
        "variant": "secondary"
      },
      "children": []
    },
    "source-cron": {
      "type": "Badge",
      "props": {
        "text": "cron-state=ok",
        "variant": "secondary"
      },
      "children": []
    }
  }
}
