    "stat_notes": {
      "type": "Stat",
      "props": {
        "label": "Notes",
        "value": "195"
      }
    },
    "stat_edges": {
      "type": "Stat",
      "props": {
        "label": "Edges",
        "value": "1987"
      }
    },
    "stat_omissions": {
      "type": "Stat",
      "props": {
        "label": "Omissions",
        "value": "1"
      }
    },
    "stat_broken": {
      "type": "Stat",
      "props": {
        "label": "Broken",
        "value": "0"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {}
    },
    "heading_branch": {
      "type": "Heading",
      "props": {
        "text": "Branch & PR",
        "level": "h3"
      }
    },
    "stack_branch_content": {
      "type": "Stack",
