{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Notegraph updated"
      },
      "children": [
        "stack_content"
      ]
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "stat_wired",
        "sep1",
        "heading_metrics",
        "grid_metrics",
        "sep2",
        "heading_branch",
        "stack_branch_content",
        "sep3",
        "heading_new",
        "stack_new_content"
      ]
    },
    "stat_wired": {
      "type": "Stat",
      "props": {
        "label": "Notes wired in",
        "value": "+2"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {}
    },
    "heading_metrics": {
      "type": "Heading",
      "props": {
        "text": "Graph metrics",
        "level": "h3"
      }
    },
    "grid_metrics": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "sm"
