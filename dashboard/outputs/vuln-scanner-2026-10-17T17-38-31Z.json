    "scanner-slither": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "scanner-slither-name",
        "scanner-slither-status"
      ]
    },
    "scanner-slither-name": {
      "type": "Text",
      "props": {
        "text": "slither",
        "variant": "caption"
      }
    },
    "scanner-slither-status": {
      "type": "Badge",
      "props": {
        "text": "n/a",
        "variant": "outline"
      }
