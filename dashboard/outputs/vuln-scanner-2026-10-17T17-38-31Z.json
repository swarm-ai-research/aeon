{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Vuln Scanner — CopilotKit/OpenDots",
        "description": "Security vulnerability scan for 5.5k star TypeScript project (HEAD ab39f25)"
      },
      "children": [
        "repo-info",
        "sep1",
        "code-audit-section",
        "sep2",
        "deps-section",
        "sep3",
        "scanners-section",
        "sep4",
        "draft-note"
      ]
    },
    "repo-info": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "repo-badge-stars",
        "repo-badge-lang",
        "repo-badge-head"
      ]
    },
    "repo-badge-stars": {
      "type": "Badge",
      "props": {
        "text": "5.5k stars",
        "variant": "secondary"
      }
    },
    "repo-badge-lang": {
      "type": "Badge",
      "props": {
        "text": "TypeScript",
        "variant": "secondary"
      }
    },
    "repo-badge-head": {
      "type": "Badge",
      "props": {
        "text": "HEAD ab39f25",
        "variant": "outline"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "code-audit-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "audit-heading",
        "audit-vulns",
        "audit-secrets"
      ]
    },
    "audit-heading": {
      "type": "Heading",
      "props": {
        "text": "Code Audit",
        "level": "h3"
      }
    },
    "audit-vulns": {
      "type": "Text",
      "props": {
        "text": "0 confirmed vulnerabilities across 3 semgrep candidates",
        "variant": "body"
      }
    },
    "audit-secrets": {
      "type": "Text",
      "props": {
        "text": "0 verified secrets (filesystem + git history scan)",
        "variant": "body"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "deps-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "deps-heading",
        "deps-intro",
        "deps-table"
      ]
    },
    "deps-heading": {
      "type": "Heading",
      "props": {
        "text": "Dependency Updates",
        "level": "h3"
      }
    },
    "deps-intro": {
      "type": "Text",
      "props": {
        "text": "1 public-pr dep-bump drafted bundling 4 OSV advisories:",
        "variant": "body"
      }
    },
    "deps-table": {
      "type": "Table",
      "props": {
        "columns": [
          "Package",
          "From",
          "To",
          "Severity",
          "Notes"
        ],
        "rows": [
          [
            "@graphql-tools/utils",
            "11.2.2",
            "12.0.1",
            "HIGH",
            "Prod-reachable via graphql-yoga edge"
          ],
          [
            "shell-quote",
            "1.9",
            "1.11",
            "CRITICAL",
            "Dev-only via concurrently"
          ],
          [
            "source-map-js",
            "1.2.1",
            "1.2.2",
            "HIGH",
            "Dev-only via postcss"
          ],
          [
            "katex",
            "0.16",
            "—",
            "LOW",
            "Deliberately held for Renovate"
          ]
        ]
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "scanners-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
