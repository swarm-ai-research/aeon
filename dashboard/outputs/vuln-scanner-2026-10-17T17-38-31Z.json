        "text": "trufflehog (fs+git)",
        "variant": "caption"
      }
    },
    "scanner-trufflehog-status": {
      "type": "Badge",
      "props": {
        "text": "ok",
        "variant": "secondary"
      }
    },
    "scanner-osv": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "scanner-osv-name",
        "scanner-osv-status"
      ]
