{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "PR Review",
        "description": "2026-07-16"
      },
      "children": [
        "main_stack"
      ]
    },
    "main_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "summary_grid",
        "sep1",
        "pr_stack"
      ]
    },
    "summary_grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "reviewed_stat",
        "skipped_stat"
      ]
    },
    "reviewed_stat": {
      "type": "Stat",
      "props": {
        "label": "Reviewed",
        "value": "1"
      },
      "children": []
    },
    "skipped_stat": {
      "type": "Stat",
      "props": {
        "label": "Skipped",
        "value": "5",
        "delta": "dependabot"
      },
      "children": []
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "pr_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "pr_link",
        "status_badges",
        "metrics_section",
        "issue_alert"
      ]
    },
    "pr_link": {
      "type": "StoryLink",
      "props": {
        "title": "swarm-ai-research/swarm#527",
        "href": "https://github.com/swarm-ai-research/swarm/pull/527",
        "source": "GitHub"
      },
      "children": []
    },
    "status_badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "approve_badge",
        "rating_badge",
        "merge_badge"
      ]
    },
    "approve_badge": {
      "type": "Badge",
      "props": {
        "text": "APPROVE",
        "variant": "default"
      },
      "children": []
    },
    "rating_badge": {
      "type": "Badge",
      "props": {
        "text": "5/5",
        "variant": "secondary"
      },
      "children": []
    },
    "merge_badge": {
      "type": "Badge",
      "props": {
        "text": "CLEAN",
        "variant": "default"
      },
      "children": []
    },
    "metrics_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "metrics_grid",
        "path_info",
        "tests_info"
      ]
    },
    "metrics_grid": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "md"
      },
      "children": [
        "checks_stat",
        "added_stat",
        "removed_stat",
        "tests_stat"
      ]
    },
    "checks_stat": {
      "type": "Stat",
      "props": {
        "label": "Checks",
        "value": "19",
        "trend": "up"
      },
      "children": []
    },
    "added_stat": {
      "type": "Stat",
      "props": {
        "label": "Lines Added",
        "value": "+2590"
      },
      "children": []
    },
    "removed_stat": {
      "type": "Stat",
      "props": {
        "label": "Lines Removed",
        "value": "−0"
      },
      "children": []
    },
    "tests_stat": {
      "type": "Stat",
      "props": {
        "label": "Tests",
        "value": "48"
      },
      "children": []
    },
    "path_info": {
      "type": "Text",
      "props": {
        "text": "Path: swarm/neurosymbolic/ (additive)",
        "variant": "caption"
      },
      "children": []
    },
    "tests_info": {
      "type": "Text",
      "props": {
        "text": "Includes: drift guard on emitted .scl",
        "variant": "caption"
      },
      "children": []
    },
    "issue_alert": {
      "type": "Alert",
      "props": {
        "title": "Authorization Error",
        "message": "gh pr review --approve returned 23rd consecutive cross-org 403 per [[aeon-app-no-write-on-swarm-repo]]; verdict logged per SKILL fallback.",
        "type": "warning"
      },
      "children": []
    }
  }
}
