{
  "root": "card-root",
  "state": {},
  "elements": {
    "card-root": {
      "type": "Card",
      "props": {
        "title": "Reflect — Memory Consolidated"
      },
      "children": [
        "main-stack"
      ]
    },
    "main-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "date-and-metrics",
        "separator-1",
        "details-section"
      ]
    },
    "date-and-metrics": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "date-badge",
        "metrics-grid"
      ]
    },
    "date-badge": {
      "type": "Badge",
      "props": {
        "text": "2026-07-24",
        "variant": "secondary"
      }
    },
    "metrics-grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "metric-notes",
        "metric-entries"
      ]
    },
    "metric-notes": {
      "type": "Stat",
      "props": {
        "label": "Notes Added",
        "value": "+4"
      }
    },
    "metric-entries": {
      "type": "Stat",
      "props": {
        "label": "Entries",
        "value": "+51"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "details-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "details-heading",
        "detail-items"
      ]
    },
    "details-heading": {
      "type": "Heading",
      "props": {
        "text": "Changes",
        "level": "h3"
      }
    },
    "detail-items": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "detail-splits",
        "detail-atomic",
        "detail-watchdog"
      ]
    },
    "detail-splits": {
      "type": "Text",
      "props": {
        "text": "2 splits"
      }
    },
    "detail-atomic": {
      "type": "Text",
      "props": {
        "text": "2 new atomic notes on four-identity + five-branch-prefix pr-tracker widening"
      }
    },
    "detail-watchdog": {
      "type": "Text",
      "props": {
        "text": "fleet-watchdog Day-5 folded"
      }
    }
  }
}
