{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "reflect"
      },
      "children": [
        "heading",
        "separator",
        "content"
      ]
    },
    "heading": {
      "type": "Heading",
      "props": {
        "text": "Memory consolidated",
        "level": "h3"
      }
    },
    "separator": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "dateText",
        "metricsSection"
      ]
    },
    "dateText": {
      "type": "Text",
      "props": {
        "text": "2026-08-22",
        "variant": "muted"
      }
    },
    "metricsSection": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "noteStat",
        "editStat",
        "statsText"
      ]
    },
    "noteStat": {
      "type": "Stat",
      "props": {
        "label": "Notes",
        "value": "+1"
      }
    },
    "editStat": {
      "type": "Stat",
      "props": {
        "label": "Edits",
        "value": "+11"
      }
    },
    "statsText": {
      "type": "Text",
      "props": {
        "text": "0 splits, 0 new",
        "variant": "caption"
      }
    }
  }
}
