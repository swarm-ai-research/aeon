{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "stale-content-pr-sweeper",
        "description": "Closed stale pull requests"
      },
      "children": [
        "stack_main"
      ]
    },
    "stack_main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "stat_closed",
        "separator_1",
        "stack_pr_details"
      ]
    },
    "stat_closed": {
      "type": "Stat",
      "props": {
        "label": "Stale PRs closed",
        "value": "1"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stack_pr_details": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "stack_stale_pr",
        "stack_superseded_by"
      ]
    },
    "stack_stale_pr": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge_stale",
        "link_pr_53"
      ]
    },
    "badge_stale": {
      "type": "Badge",
      "props": {
        "text": "Stale",
        "variant": "destructive"
      }
    },
    "link_pr_53": {
      "type": "Link",
      "props": {
        "label": "#53",
        "href": "https://github.com/anthropic-contrib/aeon/pull/53"
      }
    },
    "stack_superseded_by": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "text_superseded_by",
        "link_pr_55"
      ]
    },
    "text_superseded_by": {
      "type": "Text",
      "props": {
        "text": "Superseded by newer run:",
        "variant": "caption"
      }
    },
    "link_pr_55": {
      "type": "Link",
      "props": {
        "label": "#55",
        "href": "https://github.com/anthropic-contrib/aeon/pull/55"
      }
    }
  }
}
