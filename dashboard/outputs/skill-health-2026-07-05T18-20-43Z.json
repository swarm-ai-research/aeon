      }
    },
    "sep1": {
      "type": "Separator"
    },
    "breakdown": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat_degraded",
        "stat_nodata",
        "stat_healthy"
      ]
    },
    "stat_degraded": {
      "type": "Stat",
      "props": {
        "label": "Degraded",
        "value": "38"
      }
    },
    "stat_nodata": {
      "type": "Stat",
      "props": {
        "label": "No Data",
        "value": "2"
      }
    },
    "stat_healthy": {
      "type": "Stat",
      "props": {
        "label": "Healthy",
        "value": "4"
      }
    },
    "sep2": {
      "type": "Separator"
    },
    "detailed": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "degraded_section",
        "nodata_section",
        "healthy_section"
      ]
