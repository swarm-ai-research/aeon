    "card_main": {
      "type": "Card",
      "props": {
        "title": "Skill Health — 2026-07-05",
        "description": "Aeon health monitoring report"
      },
      "children": [
        "alert_health",
        "sep1",
        "breakdown",
        "sep2",
        "detailed",
        "sep3",
        "state_info"
      ]
