{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "compute-macro-correlate",
        "description": "2026-07-12 — Macro correlation tracking"
      },
      "children": [
        "track-a",
        "sep1",
        "correlation-section",
        "sep2",
        "track-b"
      ]
    },
    "track-a": {
      "type": "Alert",
      "props": {
        "type": "info",
        "title": "Track A",
        "message": "all null"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "correlation-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "corr-title",
        "corr-desc",
        "corr-table",
        "corr-meta"
      ]
    },
    "corr-title": {
      "type": "Heading",
      "props": {
        "text": "RENDER/TAO/IO vs NATGAS Correlation (partial ρ, orthogonal to {BTC,SOL})",
        "level": "h3"
      }
    },
    "corr-desc": {
      "type": "Text",
      "props": {
        "text": "All correlations |ρ|<0.15 (below significance threshold)",
        "variant": "body"
      }
    },
    "corr-table": {
      "type": "Table",
      "props": {
        "columns": [
          "Token",
          "Correlation (ρ)",
          "p-value"
        ],
        "rows": [
          [
            "RENDER",
            "−0.12",
            "0.16"
          ],
          [
            "TAO",
            "−0.12",
            "0.19"
          ],
          [
            "IO",
            "−0.06",
            "0.53"
          ]
        ]
      }
    },
    "corr-meta": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "meta-n",
        "meta-btc-sol",
        "meta-scan"
      ]
    },
    "meta-n": {
      "type": "Text",
      "props": {
        "text": "Sample size: n=130",
        "variant": "caption"
      }
    },
    "meta-btc-sol": {
      "type": "Text",
      "props": {
        "text": "BTC and SOL: all |ρ|<0.15",
        "variant": "caption"
      }
    },
    "meta-scan": {
      "type": "Alert",
      "props": {
        "type": "success",
        "message": "Wider macro scan clean: no non-control hit ≥0.15 for any token"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "track-b": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "track-b-title",
        "track-b-progress",
        "track-b-note"
      ]
    },
    "track-b-title": {
      "type": "Heading",
      "props": {
        "text": "Track B",
        "level": "h3"
      }
    },
    "track-b-progress": {
      "type": "Progress",
      "props": {
        "value": 25,
        "max": 30,
        "label": "Joined days"
      }
    },
    "track-b-note": {
      "type": "Text",
      "props": {
        "text": "Deferring: n=25 joined days, 5 more needed to unlock sweep-P&L track",
        "variant": "caption"
      }
    }
  }
}
