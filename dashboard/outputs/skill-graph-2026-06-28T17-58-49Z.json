{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Skill Graph initialized",
        "description": "Skill mapping and branch push completed"
      },
      "children": [
        "stack-content"
      ]
    },
    "stack-content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "grid-stats",
        "sep-1",
        "text-branch",
        "alert-pr-blocked",
        "link-pr-manual"
      ]
    },
    "grid-stats": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": [
        "stat-skills-mapped",
        "stat-categories",
        "stat-enabled"
      ]
    },
    "stat-skills-mapped": {
      "type": "Stat",
      "props": {
        "label": "Skills Mapped",
        "value": "173"
      }
    },
    "stat-categories": {
      "type": "Stat",
      "props": {
        "label": "Categories",
        "value": "5"
      }
    },
    "stat-enabled": {
      "type": "Stat",
      "props": {
        "label": "Enabled",
        "value": "44"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "text-branch": {
      "type": "Text",
      "props": {
        "text": "Branch pushed: skill-graph/2026-06-28",
        "variant": "body"
      }
    },
    "alert-pr-blocked": {
      "type": "Alert",
      "props": {
        "type": "warning",
        "title": "PR Creation Blocked",
        "message": "App permission gap prevents automatic PR creation"
      }
    },
    "link-pr-manual": {
      "type": "Link",
      "props": {
        "label": "Open PR manually",
        "href": "https://github.com/swarm-ai-research/aeon/pull/new/skill-graph/2026-06-28"
      }
    }
  }
}
