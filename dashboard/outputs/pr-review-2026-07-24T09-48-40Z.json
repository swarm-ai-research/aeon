      "props": {
        "label": "Confidence",
        "value": "4/5"
      }
    },
    "pr-details": {
      "type": "Text",
      "props": {
        "text": "Docs-only prose de-slop (12 .md files)",
        "variant": "body"
      }
    },
    "pr-warning": {
      "type": "Alert",
      "props": {
        "title": "Write access blocked",
        "message": "403-blocked (11th invocation of [[aeon-app-no-write-on-swarm-repo]]). Quality gate shows FAILURE due to pre-existing test-3.12-full flake, unrelated to this PR. Review findings preserved in log.",
        "type": "warning"
      }
    }
  }
}
