        "variant": "default"
      }
    },
    "badge-quality-gate": {
      "type": "Badge",
      "props": {
        "text": "Quality gate: FAILURE",
        "variant": "destructive"
      }
    },
    "pr-stats": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
