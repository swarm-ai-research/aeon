{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "PR Review",
        "description": "2026-07-24"
      },
      "children": [
        "summary-section",
        "separator-1",
        "pr-section"
      ]
    },
    "summary-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "summary-heading",
        "summary-stats",
        "skipped-breakdown"
      ]
    },
    "summary-heading": {
      "type": "Heading",
      "props": {
        "text": "Summary",
        "level": "h3"
      }
    },
    "summary-stats": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat-reviewed",
        "stat-skipped"
      ]
    },
    "stat-reviewed": {
      "type": "Stat",
      "props": {
        "label": "Reviewed",
        "value": "1"
      }
    },
    "stat-skipped": {
      "type": "Stat",
      "props": {
        "label": "Skipped",
        "value": "5"
      }
    },
    "skipped-breakdown": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "skipped-label",
        "skipped-items"
      ]
    },
    "skipped-label": {
      "type": "Text",
      "props": {
        "text": "Skipped breakdown:",
        "variant": "caption"
      }
    },
    "skipped-items": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "item-drafts",
        "item-bots",
        "item-dup-sha",
        "item-bot-reviewed"
      ]
    },
    "item-drafts": {
      "type": "Text",
      "props": {
        "text": "Drafts: 0",
        "variant": "body"
      }
    },
    "item-bots": {
      "type": "Text",
      "props": {
        "text": "Bots: 4",
        "variant": "body"
      }
    },
    "item-dup-sha": {
      "type": "Text",
      "props": {
        "text": "Duplicate SHA: 1",
        "variant": "body"
      }
    },
    "item-bot-reviewed": {
      "type": "Text",
      "props": {
        "text": "Bot reviewed recently: 0",
        "variant": "body"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "pr-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
