    "pr-link": {
      "type": "StoryLink",
      "props": {
        "title": "swarm-ai-research/swarm#543",
        "href": "https://github.com/swarm-ai-research/swarm/pull/543"
      }
    },
    "pr-status-badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge-approve",
        "badge-docs-gates",
        "badge-quality-gate"
      ]
