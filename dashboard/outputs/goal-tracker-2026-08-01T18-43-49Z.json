{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Goal Tracker Status",
        "description": "Tracking is blocked due to memory reorganization"
      },
      "children": [
        "alert",
        "sep1",
        "problem-section",
        "sep2",
        "snapshot-section",
        "sep3",
        "solutions-section"
      ]
    },
    "alert": {
      "type": "Alert",
      "props": {
        "title": "NO_GOALS",
        "message": "day-7 (2026-08-01)",
        "type": "warning"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "problem-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "prob-title",
        "prob-text",
        "prob-cause",
        "prob-constraint"
      ]
    },
    "prob-title": {
      "type": "Heading",
      "props": {
        "text": "Problem",
        "level": "h3"
      }
    },
    "prob-text": {
      "type": "Text",
      "props": {
        "text": "MEMORY.md still has neither '## Goals' nor '## Next Priorities' sections. Goal bullets live under '## Pointers' instead.",
        "variant": "body"
      }
    },
    "prob-cause": {
      "type": "Text",
      "props": {
        "text": "Root cause: Memory section header renamed on 2026-07-26 per issue [[memory-section-header-rename-breaks-goal-tracker]]",
        "variant": "caption"
      }
    },
    "prob-constraint": {
      "type": "Text",
      "props": {
        "text": "Constraint: SKILL forbids inventing goals — prior snapshot must be respected",
        "variant": "caption"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "snapshot-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "snap-title",
        "snap-details"
      ]
    },
    "snap-title": {
      "type": "Heading",
      "props": {
        "text": "Prior Snapshot",
        "level": "h3"
      }
    },
    "snap-details": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "snap-file",
        "snap-goals",
        "snap-time"
      ]
    },
    "snap-file": {
      "type": "Text",
      "props": {
        "text": "File: memory/goal-state.json",
        "variant": "body"
      }
    },
    "snap-goals": {
      "type": "Text",
      "props": {
        "text": "Goals stored: 19",
        "variant": "body"
      }
    },
    "snap-time": {
      "type": "Text",
      "props": {
        "text": "Last snapshot: 2026-07-25T18:45Z",
        "variant": "body"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "solutions-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "sol-title",
        "sol-a",
        "sol-b"
      ]
    },
    "sol-title": {
      "type": "Heading",
      "props": {
        "text": "Unblock Options",
        "level": "h3"
      }
    },
    "sol-a": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "sol-a-badge",
        "sol-a-text"
      ]
    },
    "sol-a-badge": {
      "type": "Badge",
      "props": {
        "text": "Option (a)",
        "variant": "secondary"
      }
    },
    "sol-a-text": {
      "type": "Text",
      "props": {
        "text": "Rename '## Pointers' → '## Next Priorities' in MEMORY.md (one-liner)",
        "variant": "body"
      }
    },
    "sol-b": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "sol-b-badge",
        "sol-b-text"
      ]
    },
    "sol-b-badge": {
      "type": "Badge",
      "props": {
        "text": "Option (b)",
        "variant": "secondary"
      }
    },
    "sol-b-text": {
      "type": "Text",
      "props": {
        "text": "Patch skills/goal-tracker/SKILL.md fallback list to include '## Pointers'",
        "variant": "body"
      }
    }
  }
}
