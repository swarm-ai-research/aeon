{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "skill-repair — Systemic Cluster Diagnosis",
        "description": "REPAIR_DIAGNOSED_NO_FIX: Anthropic auth/availability incident with blocked fix"
