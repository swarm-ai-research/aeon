      "children": [
        "alert_status",
        "sep1",
        "target_section",
        "sep2",
        "root_cause_section",
        "sep3",
        "recovery_section",
        "sep4",
        "fix_section",
        "sep5",
        "action_section"
      ]
    },
    "alert_status": {
      "type": "Alert",
      "props": {
        "title": "REPAIR_DIAGNOSED_NO_FIX",
