    "action_heading": {
      "type": "Heading",
      "props": {
        "text": "Operator Action Required",
        "level": "h3"
      }
    },
    "action_stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "action_read",
        "action_patch",
        "action_redispatch",
        "action_verify"
      ]
