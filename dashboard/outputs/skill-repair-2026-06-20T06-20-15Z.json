    "action_patch": {
      "type": "Text",
      "props": {
        "text": "2. Open PR for branch fix/skill-repair-systemic-2026-06-20 (operator permission required to merge into aeon.yml)",
        "variant": "body"
      }
    },
    "action_redispatch": {
      "type": "Text",
      "props": {
        "text": "3. After aeon.yml patch is merged, re-dispatch any affected skill to validate fix",
        "variant": "body"
      }
