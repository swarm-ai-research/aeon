        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "target_heading",
        "target_list"
      ]
    },
    "target_heading": {
      "type": "Heading",
      "props": {
        "text": "Affected Skills",
        "level": "h3"
      }
