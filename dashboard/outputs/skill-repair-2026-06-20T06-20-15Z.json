    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "root_cause_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "root_cause_heading",
        "root_cause_type",
        "root_cause_detail",
        "root_cause_window"
      ]
    },
    "root_cause_heading": {
      "type": "Heading",
      "props": {
        "text": "Root Cause",
        "level": "h3"
      }
    },
