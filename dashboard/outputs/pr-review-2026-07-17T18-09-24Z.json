      },
      "children": []
    },
    "sha_text": {
      "type": "Text",
      "props": {
        "text": "SHA: da039d5f",
        "variant": "caption"
      },
      "children": []
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
