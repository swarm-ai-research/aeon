{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "PR Review",
        "description": "2026-07-17 — merge-gate re-invocation"
      },
      "children": [
        "section_pr",
        "sep1",
        "section_verdict",
        "sep2",
        "section_ci",
        "sep3",
        "section_tests",
        "sep4",
        "section_additional",
        "sep5",
        "section_error"
      ]
    },
    "section_pr": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "heading_pr",
        "pr_link",
        "sha_text"
      ]
    },
    "heading_pr": {
      "type": "Heading",
      "props": {
        "text": "Pull Request",
        "level": "h3"
      },
      "children": []
    },
    "pr_link": {
      "type": "Link",
      "props": {
        "label": "swarm-ai-research/swarm#527",
