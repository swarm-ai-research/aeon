{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Vuln Scanner Report"
      },
      "children": [
        "alert-clean",
        "project-stack",
        "sep-1",
        "findings-heading",
        "findings-grid",
        "sep-2",
        "details-stack",
        "sep-3",
        "scanners-heading",
        "scanners-stack",
        "sep-4",
        "report-link"
      ]
    },
    "alert-clean": {
      "type": "Alert",
      "props": {
        "message": "Clean audit",
        "type": "success"
      }
    },
    "project-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "project-name",
        "badge-stars",
        "badge-lang"
      ]
    },
    "project-name": {
      "type": "Heading",
      "props": {
        "text": "tamnd/kage",
        "level": "h3"
      }
    },
    "badge-stars": {
      "type": "Badge",
      "props": {
        "text": "2,150⭐",
        "variant": "default"
      }
    },
    "badge-lang": {
      "type": "Badge",
      "props": {
        "text": "Go",
        "variant": "secondary"
      }
    },
    "sep-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "findings-heading": {
      "type": "Heading",
      "props": {
        "text": "Findings",
        "level": "h3"
      }
    },
    "findings-grid": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": [
        "stat-candidates",
        "stat-confirmed",
        "stat-secrets",
        "stat-cves"
      ]
    },
    "stat-candidates": {
      "type": "Stat",
      "props": {
        "label": "Semgrep candidates",
        "value": "3"
      }
    },
    "stat-confirmed": {
      "type": "Stat",
      "props": {
        "label": "Confirmed issues",
        "value": "0"
      }
    },
    "stat-secrets": {
      "type": "Stat",
      "props": {
        "label": "Verified secrets",
        "value": "0"
      }
    },
    "stat-cves": {
      "type": "Stat",
      "props": {
        "label": "Dependency CVEs",
        "value": "0 of 47 modules"
      }
    },
    "sep-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "details-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "detail-false-positive",
        "detail-md5"
      ]
    },
    "detail-false-positive": {
      "type": "Text",
      "props": {
        "text": "1 false positive: hardcoded Cloudflare API URL",
        "variant": "body"
      }
    },
    "detail-md5": {
      "type": "Text",
      "props": {
        "text": "2 format-mandated MD5 uses in ZIM writer",
        "variant": "body"
      }
    },
    "sep-3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "scanners-heading": {
      "type": "Heading",
      "props": {
        "text": "Scanner Status",
        "level": "h3"
      }
    },
    "scanners-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "scanner-semgrep",
        "scanner-trufflehog",
        "scanner-osv",
        "dedup-note"
      ]
    },
    "scanner-semgrep": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "label-semgrep",
        "badge-ok-1"
      ]
    },
    "label-semgrep": {
      "type": "Text",
      "props": {
        "text": "Semgrep:",
        "variant": "caption"
      }
    },
    "badge-ok-1": {
      "type": "Badge",
      "props": {
        "text": "ok",
        "variant": "default"
      }
    },
    "scanner-trufflehog": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "label-trufflehog",
        "badge-ok-2"
      ]
    },
    "label-trufflehog": {
      "type": "Text",
      "props": {
        "text": "Trufflehog:",
        "variant": "caption"
      }
    },
    "badge-ok-2": {
      "type": "Badge",
      "props": {
        "text": "ok",
        "variant": "default"
      }
    },
    "scanner-osv": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "label-osv",
        "badge-ok-3"
      ]
    },
    "label-osv": {
      "type": "Text",
      "props": {
        "text": "OSV:",
        "variant": "caption"
      }
    },
    "badge-ok-3": {
      "type": "Badge",
      "props": {
        "text": "ok",
        "variant": "default"
      }
    },
    "dedup-note": {
      "type": "Text",
      "props": {
        "text": "Dedup updated",
        "variant": "muted"
      }
    },
    "sep-4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "report-link": {
      "type": "StoryLink",
      "props": {
        "title": "Full Vulnerability Scan Report",
        "href": "articles/vuln-scan-2026-06-20.md",
        "source": "Report"
      }
    }
  }
}
