      "props": {
        "text": "2026-06-20 compute-futures proofs cluster"
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "branch-status-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
