      "type": "Text",
      "props": {
        "text": "AI Platform Director or CFO-staff at a Fortune-2000 with >$2M/yr inference spend who's been asked to \"lock in pricing for FY27\" — a question no current vendor answers.",
        "variant": "body"
      }
    },
