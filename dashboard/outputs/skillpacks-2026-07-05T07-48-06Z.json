{
  "root": "card_main",
  "state": {},
  "elements": {
    "card_main": {
      "type": "Card",
      "props": {
        "title": "Skillpacks updated"
      },
      "children": [
        "stack_content"
      ]
    },
    "stack_content": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "stat_new_packs",
        "separator_1",
        "stack_pack_details",
        "text_branch_status",
        "alert_pr_blocked",
        "stack_pr_action"
      ]
    },
    "stat_new_packs": {
      "type": "Stat",
      "props": {
        "label": "New skillpack(s)",
        "value": "1"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "stack_pack_details": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "text_pack_name",
        "text_pack_composition"
      ]
    },
    "text_pack_name": {
      "type": "Text",
      "props": {
        "text": "outages-fleet",
        "variant": "lead"
      }
    },
    "text_pack_composition": {
      "type": "Text",
      "props": {
        "text": "batch-health joined the fleet-evolve cluster, renamed to outages-fleet"
      }
    },
    "text_branch_status": {
      "type": "Text",
      "props": {
        "text": "Branch pushed"
      }
    },
    "alert_pr_blocked": {
      "type": "Alert",
      "props": {
        "title": "PR creation blocked",
        "message": "Actions cannot open PRs due to repo policy",
        "type": "warning"
      }
    },
    "stack_pr_action": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "text_manual_label",
        "link_manual_pr"
      ]
    },
    "text_manual_label": {
      "type": "Text",
      "props": {
        "text": "Manual open:",
        "variant": "caption"
      }
    },
    "link_manual_pr": {
      "type": "Link",
      "props": {
        "label": "Create PR",
        "href": "https://github.com/swarm-ai-research/aeon/pull/new/skillpacks/2026-07-05"
      }
    }
  }
}
