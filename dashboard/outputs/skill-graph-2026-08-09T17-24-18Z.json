{
  "root": "card",
  "state": {},
  "elements": {
    "card": {
      "type": "Card",
      "props": {
        "title": "Skill Graph"
      },
      "children": [
        "main-stack"
      ]
    },
    "main-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "heading",
        "metrics-grid",
        "pr-link"
      ]
    },
    "heading": {
      "type": "Heading",
      "props": {
        "text": "Skill Graph initialized",
        "level": "h2"
      }
    },
    "metrics-grid": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": [
        "stat-skills",
        "stat-categories",
        "stat-enabled"
      ]
    },
    "stat-skills": {
      "type": "Stat",
      "props": {
        "label": "Skills mapped",
        "value": "172"
      }
    },
    "stat-categories": {
      "type": "Stat",
      "props": {
        "label": "Categories",
        "value": "6"
      }
    },
    "stat-enabled": {
      "type": "Stat",
      "props": {
        "label": "Enabled",
        "value": "43"
      }
    },
    "pr-link": {
      "type": "StoryLink",
      "props": {
        "title": "View PR #25",
        "href": "https://github.com/swarm-ai-research/aeon/pull/25",
        "source": "GitHub"
      }
    }
  }
}
