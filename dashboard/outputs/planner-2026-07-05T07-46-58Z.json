{
  "root": "card-root",
  "state": {},
  "elements": {
    "card-root": {
      "type": "Card",
      "props": {
        "title": "Planner"
      },
      "children": [
        "main-stack"
      ]
    },
    "main-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "focus-section",
        "watching-section",
        "queued-section",
        "held-section",
        "blocker-section"
      ]
    },
    "focus-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "focus-heading",
        "focus-task",
        "focus-meta"
      ]
    },
    "focus-heading": {
      "type": "Heading",
      "props": {
        "text": "Current Focus",
        "level": "h2"
      }
    },
    "focus-task": {
      "type": "Text",
      "props": {
        "text": "Drafting the ISS-006 messages.yml per-slot cron rewrite on fix/iss-006-per-slot-crons"
      }
    },
    "focus-meta": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge-streak",
        "note-yesterday"
      ]
    },
    "badge-streak": {
      "type": "Badge",
      "props": {
        "text": "Streak 3 (third planner run)",
        "variant": "secondary"
      }
    },
    "note-yesterday": {
      "type": "Text",
      "props": {
        "text": "Yesterday's 'draft the diff' step never landed, so no more restating.",
        "variant": "caption"
      }
    },
    "watching-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "watching-heading",
        "watching-item"
      ]
    },
    "watching-heading": {
      "type": "Heading",
      "props": {
        "text": "Watching",
        "level": "h2"
      }
    },
    "watching-item": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "watching-batch",
        "watching-threshold"
      ]
    },
    "watching-batch": {
      "type": "Text",
      "props": {
        "text": "Sunday morning batch: janitor/skillpacks/compute-macro-correlate"
      }
    },
    "watching-threshold": {
      "type": "Badge",
      "props": {
        "text": "2× threshold today",
        "variant": "outline"
      }
    },
    "queued-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "queued-heading",
        "queued-item"
      ]
    },
    "queued-heading": {
      "type": "Heading",
      "props": {
        "text": "Queuing",
        "level": "h2"
      }
    },
    "queued-item": {
      "type": "Text",
      "props": {
        "text": "pr-tracker step-5 fresh-bot-PR trigger patch"
      }
    },
    "held-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "held-heading",
        "held-items"
      ]
    },
    "held-heading": {
      "type": "Heading",
      "props": {
        "text": "Holding",
        "level": "h2"
      }
    },
    "held-items": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "held-iss-005",
        "held-agent-reach"
      ]
    },
    "held-iss-005": {
      "type": "Text",
      "props": {
        "text": "ISS-005 reclassify"
      }
    },
    "held-agent-reach": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "agent-reach-text",
        "agent-reach-badge"
      ]
    },
    "agent-reach-text": {
      "type": "Text",
      "props": {
        "text": "Agent-Reach#436"
      }
    },
    "agent-reach-badge": {
      "type": "Badge",
      "props": {
        "text": "already flagged yesterday",
        "variant": "outline"
      }
    },
    "blocker-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "blocker-heading",
        "blocker-context",
        "blocker-alert"
      ]
    },
    "blocker-heading": {
      "type": "Heading",
      "props": {
        "text": "Blockers",
        "level": "h2"
      }
    },
    "blocker-context": {
      "type": "Text",
      "props": {
        "text": "This would be the 7th pending branch",
        "variant": "caption"
      }
    },
    "blocker-alert": {
      "type": "Alert",
      "props": {
        "title": "Real unblock needed",
        "message": "Provisioning a cross-repo PAT",
        "type": "warning"
      }
    }
  }
}
