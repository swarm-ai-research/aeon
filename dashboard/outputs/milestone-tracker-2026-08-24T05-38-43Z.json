{
  "root": "card-root",
  "state": {},
  "elements": {
    "card-root": {
      "type": "Card",
      "props": {
        "title": "milestone-tracker",
        "description": "Weekly progress tracking for key product and growth milestones — celebrates crossings, alerts on approaches, surfaces stalls"
      },
      "children": [
        "tags-section",
        "sep1",
        "overview-section",
        "sep2",
        "features-section",
        "sep3",
        "output-section",
        "sep4",
        "milestones-section"
      ]
    },
    "tags-section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "tags-label",
        "meta-badge",
        "projects-badge"
      ]
    },
    "tags-label": {
      "type": "Text",
      "props": {
        "text": "Tags:",
        "variant": "muted"
      }
    },
    "meta-badge": {
      "type": "Badge",
      "props": {
        "text": "meta",
        "variant": "outline"
      }
    },
    "projects-badge": {
      "type": "Badge",
      "props": {
        "text": "projects",
        "variant": "outline"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "overview-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "overview-heading",
        "overview-text"
      ]
    },
    "overview-heading": {
      "type": "Heading",
      "props": {
        "text": "What This Skill Does",
        "level": "h2"
      }
    },
    "overview-text": {
      "type": "Text",
      "props": {
        "text": "The milestone-tracker skill monitors progress toward defined milestones across repos, system capabilities, and product goals."
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "features-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "features-heading",
        "feature-1",
        "feature-2",
        "feature-3",
        "feature-4"
      ]
    },
    "features-heading": {
      "type": "Heading",
      "props": {
        "text": "Features",
        "level": "h3"
      }
    },
    "feature-1": {
      "type": "Text",
      "props": {
        "text": "• Loads milestone configuration from memory/milestones.md with targets for various metrics",
        "variant": "body"
      }
    },
    "feature-2": {
      "type": "Text",
      "props": {
        "text": "• Fetches current state by querying GitHub star counts via gh api for repo star milestones, enabled skills count from aeon.yml, and manual milestones",
        "variant": "body"
      }
    },
    "feature-3": {
      "type": "Text",
      "props": {
        "text": "• Classifies each milestone as: crossed (just hit target), done (already crossed), approaching (within 10% of target), stalled (no movement for 2+ weeks), or on-track (making progress)",
        "variant": "body"
      }
    },
    "feature-4": {
      "type": "Text",
      "props": {
        "text": "• Generates notifications only when there's something notable (crossed, approaching, or stalled milestones)",
        "variant": "body"
      }
    },
    "sep3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "output-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "output-heading",
        "output-desc",
        "output-file-path",
        "output-sections-label",
        "output-item-1",
        "output-item-2",
        "output-item-3",
        "output-item-4",
        "output-updates"
      ]
    },
    "output-heading": {
      "type": "Heading",
      "props": {
        "text": "Output Format",
        "level": "h3"
      }
    },
    "output-desc": {
      "type": "Text",
      "props": {
        "text": "The skill generates a markdown notification file at .pending-notify-temp/milestone-tracker-${today}.md with sections for:"
      }
    },
    "output-sections-label": {
      "type": "Text",
      "props": {
        "text": "Sections included:",
        "variant": "muted"
      }
    },
    "output-item-1": {
      "type": "Text",
      "props": {
        "text": "• Crossed milestones",
        "variant": "body"
      }
    },
    "output-item-2": {
      "type": "Text",
      "props": {
        "text": "• Approaching milestones",
        "variant": "body"
      }
    },
    "output-item-3": {
      "type": "Text",
      "props": {
        "text": "• Stalled milestones",
        "variant": "body"
      }
    },
    "output-item-4": {
      "type": "Text",
      "props": {
        "text": "• On-track progress with movement",
        "variant": "body"
      }
    },
    "output-updates": {
      "type": "Text",
      "props": {
        "text": "Also updates memory/milestones.md with current values and statuses, and logs summary statistics to memory/logs/${today}.md"
      }
    },
    "sep4": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "milestones-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "milestones-heading",
        "milestone-1",
        "milestone-2",
        "milestone-3"
      ]
    },
    "milestones-heading": {
      "type": "Heading",
      "props": {
        "text": "Milestone Types Supported",
        "level": "h3"
      }
    },
    "milestone-1": {
      "type": "Text",
      "props": {
        "text": "• stars:{owner}/{repo}:{target} — GitHub repo star count tracking",
        "variant": "body"
      }
    },
    "milestone-2": {
      "type": "Text",
      "props": {
        "text": "• skills:{target} — count of enabled skills in aeon.yml",
        "variant": "body"
      }
    },
    "milestone-3": {
      "type": "Text",
      "props": {
        "text": "• manual:{label} — operator-maintained milestones (text-based)",
        "variant": "body"
      }
    }
  }
}
