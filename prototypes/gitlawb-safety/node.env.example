# GitLawb node config for hosting Aeon agents under the bridge (Phase 1).
#
# The bridge can only be the enforcement point if the node it fronts does not
# accept writes the bridge hasn't seen. So run the node PRIVATE and make the
# bridge the only ingress.

# Do not serve repos to the open mesh — the bridge mediates all access.
GITLAWB_PUBLIC_READ=false

# v0.1 caveat: direct HTTP `git-receive-pack` is UNAUTHENTICATED unless the
# gitlawb:// remote helper is used. Do NOT expose this route publicly; keep the
# node bound to localhost / private network and let the bridge be the front
# door. (Reverse proxies should refuse POST /*/git-receive-pack from outside.)
GITLAWB_BIND=127.0.0.1:8420

# libp2p bootstrap peers the bridge's GossipEventSource will dial (Phase 1
# infra task). Comma-separated multiaddrs.
GITLAWB_BOOTSTRAP_PEERS=

# Postgres for node state + (production) the revocation store. The prototype
# bridge uses a file-backed RevocationStore; swap to this behind the same
# interface for production.
DATABASE_URL=

# Phase 4 economic trust (BaseChainStakeOracle). The bridge gates which nodes
# it accepts events from by their on-chain stake / heartbeat / slash status.
# Not live yet: GitLawb v1 has no slashing and staking is paused on Sepolia, so
# the prototype uses MockStakeOracle. Set these when mainnet staking ships.
GITLAWB_BASE_RPC_URL=
GITLAWB_NODE_STAKING_ADDRESS=
GITLAWB_USER_STAKING_ADDRESS=
