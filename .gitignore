# macOS
.DS_Store

# Secrets & local env
.env
.env.local
.env.*.local

# Claude Code local state
.claude/

# Caches (regenerated per run)
.xai-cache/
.bankr-cache/
.surplus-cache/
.runpod-cache/
.macro-cache/
.pending-notify/
.pending-replicate/
.pending-supernotes/
.pending-deploy/
.pending-devto/
.pending-farcaster/
.tg_cache/

# Skill provenance lock (per-repo, not committed)
skills.lock

# Scratch / temp files
tmp_*
*.tmp
.tmp-*
.pending-*.sh
.run-*.sh
.*-tmp.md
.*-draft.md
.*-msg.txt
*_msg.txt
*_raw.txt

# Leaked creds scratch
.xai_key
.ghtoken

# GitLawb capability key vault (Ed25519 private keys — never commit)
.gitlawb-vault/

# Python bytecode
__pycache__/
*.pyc

# Node
node_modules/

# Stale artifacts
.external-work
.vuln-scan/
.vuln-scan-workspace/
.vuln-scan-work/
vuln-scan-work/

# Stray local audit/debug artifacts (never commit)
.audit-tmp/
.audit*.py
# NOTE: .audit-bin/ and .audit-tools/ are intentionally tracked — they hold
# pre-cached actionlint and zizmor binaries committed after each successful
# workflow-security-audit run, used by the skill to skip re-downloading in CI.
