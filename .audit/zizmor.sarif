                              "text": "|\n          SKILL_FILE=\"skills/${{ steps.skill.outputs.name }}/SKILL.md\"\n          [ ! -f \"$SKILL_FILE\" ] && exit 0\n\n          # Extract secret references (VAR_API_KEY, VAR_TOKEN, etc.)\n          SECRETS=$(grep -oE '\\$\\{?[A-Z][A-Z0-9_]{2,}\\}?' \"$SKILL_FILE\" 2>/dev/null | \\\n            sed 's/[${}]//g' | \\\n            grep -E '_(API_KEY|KEY|TOKEN|SECRET|WEBHOOK_URL)$' | \\\n            grep -vE '^(GITHUB_TOKEN|GH_TOKEN|ANTHROPIC_API_KEY|CLAUDE_CODE_OAUTH_TOKEN|BANKR_LLM_KEY|TELEGRAM_|DISCORD_|SLACK_)' | \\\n            sort -u) || true\n\n          [ -z \"$SECRETS\" ] && exit 0\n\n          MISSING=() OPTIONAL=()\n          while IFS= read -r secret; do\n            [ -z \"$secret\" ] && continue\n            if [ -z \"${!secret:-}\" ]; then\n              if grep -qiE \"(if.*${secret}.*is (not )?set|${secret}.*(optional|falls? back)|without)\" \"$SKILL_FILE\" 2>/dev/null; then\n                OPTIONAL+=(\"$secret\")\n              else\n                MISSING+=(\"$secret\")\n              fi\n            fi\n          done <<< \"$SECRETS\"\n\n          [ ${#OPTIONAL[@]} -gt 0 ] && echo \"::notice::Optional secrets not set: ${OPTIONAL[*]} (skill will use fallbacks)\"\n          [ ${#MISSING[@]} -gt 0 ] && echo \"::warning::Secrets not set: ${MISSING[*]} — skill may fail or produce incomplete results\"\n          exit 0"
                            },
