son hi \"$HISTORY\" --argjson avg \"$AVG\" \\\n            '{skill: $sk, last_analyzed: $ts, quality_score: $sc, assessment: $as, flags: $fl, avg_score: $avg, history: $hi}' \\\n            > \"$HEALTH_FILE\"\n\n          echo \"::notice::Skill quality — $SKILL: score=$SCORE, avg=$AVG — $ASSESSMENT\""
                  },
                  "sourceLanguage": "yaml",
                  "startColumn": 21,
                  "startLine": 657
                }
              }
            }
          ],
