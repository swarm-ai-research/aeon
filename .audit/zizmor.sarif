                              "text": "name: Checkout fork\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n          # GH_GLOBAL is a fine-grained PAT with the Workflows permission.\n          # The default GITHUB_TOKEN cannot push changes to .github/workflows/*,\n          # so upstream syncs that touch workflow files get remote-rejected.\n          token: ${{ secrets.GH_GLOBAL }}"
