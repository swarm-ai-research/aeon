                          "region": {
                            "endColumn": 51,
                            "endLine": 288,
                            "snippet": {
                              "text": "|\n          TODAY=$(date -u +%Y-%m-%d)\n          SKILL_NAME=\"${{ steps.skill.outputs.name }}\"\n          export SKILL_NAME\n          CONFIG_MODEL=$(grep -E '^model:' aeon.yml | sed 's/^model: *//' | tr -d ' ')\n          # Check for per-skill model override in aeon.yml (extract quoted value, ignore comments)\n          SKILL_MODEL=$(grep \"^  ${SKILL_NAME}:\" aeon.yml | sed -n 's/.*model: *\"\\([^\"]*\\)\".*/\\1/p')\n          INPUT_MODEL=\"$_INPUT_MODEL\"\n          if [ -n \"$INPUT_MODEL\" ] && [ \"$INPUT_MODEL\" != \"(config default)\" ]; then\n            MODEL=\"$INPUT_MODEL\"\n          elif [ -n \"$SKILL_MODEL\" ]; then\n            MODEL=\"$SKILL_MODEL\"\n          else\n            MODEL=\"${CONFIG_MODEL:-claude-opus-4-7}\"\n          fi\n          echo \"Using model: $MODEL\"\n          echo \"SKILL_MODEL=$MODEL\" >> \"$GITHUB_OUTPUT\"\n\n          # --- AI Gateway routing ---\n          GATEWAY=$(grep -A1 '^gateway:' aeon.yml | grep 'provider:' | sed 's/.*provider: *//' | tr -d ' \"'\"'\" || echo \"direct\")\n          GATEWAY=\"${GATEWAY:-direct}\"\n          echo \"Gateway: $GATEWAY\"\n\n          echo \"GATEWAY=$GATEWAY\" >> \"$GITHUB_OUTPUT\"\n\n          if [ \"$GATEWAY\" = \"bankr\" ]; then\n            if [ -z \"${BANKR_LLM_KEY:-}\" ]; then\n              echo \"::error::gateway.provider=bankr but BANKR_LLM_KEY secret is not set\"\n              exit 1\n            fi\n            export ANTHROPIC_BASE_URL=\"https://llm.bankr.bot\"\n            export ANTHROPIC_AUTH_TOKEN=\"$BANKR_LLM_KEY\"\n            unset ANTHROPIC_API_KEY\n            unset CLAUDE_CODE_OAUTH_TOKEN\n            echo \"::notice::Routing through Bankr Gateway (https://llm.bankr.bot)\"\n          else\n            echo \"::notice::Using direct Anthropic API\"\n          fi\n\n          # Generate notify script in workspace (Claude calls: ./notify \"message\")\n          # Messages are saved to .pending-notify/ for reliable post-run delivery\n          # (sandbox may block outbound curl during Claude's run)\n          # Pre-create .pending-notify/ so the sandbox doesn't block Claude's first write into it\n          mkdir -p .pending-notify\n          : > .notify-sent-hashes\n\n          cat > ./notify << 'NOTIFY_SCRIPT'\n          #!/usr/bin/env bash\n          set -euo pipefail\n          MSG=\"$1\"\n\n          # Suppress obvious diagnostic probes (short messages containing test/trace/ping/debug/hello).\n          # Claude sometimes issues these to verify the notify script works — they should not reach channels.\n          MSG_LEN=${#MSG}\n          if [ \"$MSG_LEN\" -lt 120 ]; then\n            MSG_LOWER=$(printf '%s' \"$MSG\" | tr '[:upper:]' '[:lower:]')\n            case \"$MSG_LOWER\" in\n              *test*|*trace*|*ping*|*debug*|hello|hi)\n                echo \"notify: suppressing trace/test message ($MSG_LEN chars): $MSG\" >&2\n                exit 0\n                ;;\n            esac\n          fi\n\n          # Dedup within this workflow run — same message never sent twice even if ./notify is called again\n          HASH=$(printf '%s' \"$MSG\" | sha256sum | awk '{print $1}')\n          HASH_FILE=\".notify-sent-hashes\"\n          touch \"$HASH_FILE\" 2>/dev/null || true\n          if [ -f \"$HASH_FILE\" ] && grep -qxF \"$HASH\" \"$HASH_FILE\" 2>/dev/null; then\n            echo \"notify: duplicate message (hash ${HASH:0:8}), skipping\" >&2\n            exit 0\n          fi\n          printf '%s\\n' \"$HASH\" >> \"$HASH_FILE\" 2>/dev/null || true\n\n          # Always save to .pending-notify/ for post-run delivery (sandbox fallback)\n          TS=$(date -u +%s)\n          echo \"$MSG\" > \".pending-notify/${TS}.md\"\n\n          # Attempt immediate delivery (may fail in sandbox — post-run step retries)\n          DELIVERED=false\n\n          # Telegram: 4096 char limit, strict Markdown parsing\n          if [ -n \"${TELEGRAM_BOT_TOKEN:-}\" ] && [ -n \"${TELEGRAM_CHAT_ID:-}\" ]; then\n            # Split $MSG into chunks ≤3900 chars (Telegram cap 4096, leaves room for\n            # \"[i/N]\" suffix). Prefer paragraph (\\n\\n) then line (\\n) boundaries,\n            # hard-split only if a single paragraph/line exceeds the limit.\n            # Chunks emitted one per line as base64 to preserve embedded newlines.\n            TG_CHUNKS_B64=$(printf '%s' \"$MSG\" | python3 -c '\n          import sys, base64\n          LIMIT = 3900\n          text = sys.stdin.read()\n          def pack(parts, sep):\n              out, cur = [], \"\"\n              for p in parts:\n                  glue = sep if cur else \"\"\n                  if len(cur) + len(glue) + len(p) <= LIMIT:\n                      cur += glue + p\n                  else:\n                      if cur:\n                          out.append(cur); cur = \"\"\n                      if len(p) > LIMIT and sep == \"\\n\\n\":\n                          out.extend(pack(p.split(\"\\n\"), \"\\n\"))\n                      elif len(p) > LIMIT:\n                          while len(p) > LIMIT:\n                              out.append(p[:LIMIT]); p = p[LIMIT:]\n                          cur = p\n                      else:\n                          cur = p\n              if cur:\n                  out.append(cur)\n              return out\n          chunks = [text] if len(text) <= LIMIT else pack(text.split(\"\\n\\n\"), \"\\n\\n\")\n          N = len(chunks)\n          for i, c in enumerate(chunks):\n              suffix = f\"\\n\\n[{i+1}/{N}]\" if N > 1 else \"\"\n              sys.stdout.write(base64.b64encode((c + suffix).encode()).decode() + \"\\n\")\n          ')\n            while IFS= read -r TG_CHUNK_B64; do\n              [ -z \"$TG_CHUNK_B64\" ] && continue\n              TG_MSG=$(printf '%s' \"$TG_CHUNK_B64\" | base64 -d)\n              TG_RESULT=$(curl -s -w \"\\n%{http_code}\" -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\" \\\n                -H \"Content-Type: application/json\" \\\n                -d \"$(jq -n --arg chat \"$TELEGRAM_CHAT_ID\" --arg text \"$TG_MSG\" '{chat_id: $chat, text: $text, parse_mode: \"Markdown\"}')\" 2>/dev/null) || true\n              TG_HTTP=$(echo \"$TG_RESULT\" | tail -1)\n              TG_OK=$(echo \"$TG_RESULT\" | sed '$d' | jq -r '.ok // false' 2>/dev/null || echo \"false\")\n              if [ \"$TG_HTTP\" = \"200\" ] && [ \"$TG_OK\" = \"true\" ]; then\n                DELIVERED=true\n              else\n                curl -s -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\" \\\n                  -H \"Content-Type: application/json\" \\\n                  -d \"$(jq -n --arg chat \"$TELEGRAM_CHAT_ID\" --arg text \"$TG_MSG\" '{chat_id: $chat, text: $text}')\" > /dev/null 2>&1 && DELIVERED=true || true\n              fi\n              # Preserve chunk ordering in the Telegram channel\n              sleep 0.3\n            done <<< \"$TG_CHUNKS_B64\"\n          fi\n\n          if [ -n \"${DISCORD_WEBHOOK_URL:-}\" ]; then\n            curl -sf -X POST \"$DISCORD_WEBHOOK_URL\" \\\n              -H \"Content-Type: application/json\" \\\n              -d \"$(jq -n --arg text \"$MSG\" '{content: $text}')\" > /dev/null && DELIVERED=true || true\n          fi\n          if [ -n \"${SLACK_WEBHOOK_URL:-}\" ]; then\n            curl -sf -X POST \"$SLACK_WEBHOOK_URL\" \\\n              -H \"Content-Type: application/json\" \\\n              -d \"$(jq -n --arg text \"$MSG\" '{text: $text}')\" > /dev/null && DELIVERED=true || true\n          fi\n          # Email via SendGrid\n          if [ -n \"${SENDGRID_API_KEY:-}\" ] && [ -n \"${NOTIFY_EMAIL_TO:-}\" ]; then\n            FROM=\"${NOTIFY_EMAIL_FROM:-aeon@notifications.aeon.bot}\"\n            PREFIX=\"${NOTIFY_EMAIL_SUBJECT_PREFIX:-[Aeon]}\"\n            SUBJECT=\"$PREFIX ${SKILL_NAME:-notification}\"\n            HTML_BODY=$(printf '%s' \"$MSG\" | sed 's/&/\\&amp;/g; s/</\\&lt;/g; s/>/\\&gt;/g')\n            HTML_BODY=\"<html><body><pre style=\\\"font-family:monospace;white-space:pre-wrap;\\\">${HTML_BODY}</pre></body></html>\"\n            curl -sf -X POST \"https://api.sendgrid.com/v3/mail/send\" \\\n              -H \"Authorization: Bearer ${SENDGRID_API_KEY}\" \\\n              -H \"Content-Type: application/json\" \\\n              -d \"$(jq -n \\\n                --arg from \"$FROM\" \\\n                --arg to \"$NOTIFY_EMAIL_TO\" \\\n                --arg subject \"$SUBJECT\" \\\n                --arg html \"$HTML_BODY\" \\\n                --arg text \"$MSG\" \\\n                '{personalizations:[{to:[{email:$to}]}],from:{email:$from},subject:$subject,content:[{type:\"text/plain\",value:$text},{type:\"text/html\",value:$html}]}')\" > /dev/null 2>&1 || true\n          fi\n          # json-render channel — save raw message for post-run conversion\n          if [ \"${JSONRENDER_ENABLED:-false}\" = \"true\" ] && [ -n \"${SKILL_NAME:-}\" ]; then\n            mkdir -p dashboard/outputs\n            echo \"$MSG\" > \"dashboard/outputs/.pending-${SKILL_NAME}.md\"\n          fi\n\n          # Remove pending file if immediate delivery succeeded (prevents double-send)\n          if [ \"$DELIVERED\" = \"true\" ]; then\n            rm -f \".pending-notify/${TS}.md\"\n          fi\n          NOTIFY_SCRIPT\n          chmod +x ./notify\n\n          ALLOWED=\"Read,Write,Edit,Glob,Grep,WebFetch,WebSearch\"\n          ALLOWED=\"$ALLOWED,Bash(curl:*),Bash(gh:*),Bash(git:*),Bash(jq:*)\"\n          ALLOWED=\"$ALLOWED,Bash(./notify:*),Bash(./notify-jsonrender:*)\"\n          ALLOWED=\"$ALLOWED,Bash(mkdir:*),Bash(ls:*),Bash(cat:*),Bash(chmod:*)\"\n          ALLOWED=\"$ALLOWED,Bash(date:*),Bash(echo:*),Bash(node:*),Bash(npm:*),Bash(npx:*)\"\n          ALLOWED=\"$ALLOWED,Bash(python3:*)\" # swarm-safety-eval helper (install handled by prefetch-swarm-safety.sh, outside sandbox)\n          ALLOWED=\"$ALLOWED,Bash(head:*),Bash(tail:*),Bash(wc:*),Bash(sort:*),Bash(grep:*)\"\n          # In-repo scripts (e.g. rss-feed → scripts/generate-feed.sh) — see ISS-005\n          ALLOWED=\"$ALLOWED,Bash(./scripts/*),Bash(scripts/*),Bash(bash scripts/*),Bash(sh scripts/*)\"\n          # Prefetched scanner binaries for vuln-scanner — see ISS-004.\n          # The skill invokes these by PATH name (semgrep / slither / trufflehog / osv-scanner),\n          # not by absolute path, so allow both forms.\n          ALLOWED=\"$ALLOWED,Bash(semgrep:*),Bash(slither:*),Bash(trufflehog:*),Bash(osv-scanner:*)\"\n          ALLOWED=\"$ALLOWED,Bash(/home/runner/.local/bin/semgrep:*),Bash(/home/runner/.local/bin/slither:*)\"\n          ALLOWED=\"$ALLOWED,Bash(/tmp/bin/trufflehog:*),Bash(/tmp/bin/osv-scanner:*)\"\n\n          SKILL_NAME=\"${{ steps.skill.outputs.name }}\"\n          VAR=\"$SKILL_VAR\"\n\n          # Build prompt — inject chain context if running as part of a chain.\n          # The chain runner only ever writes context to .outputs/.chain-context-*.md\n          # (see chain-runner.yml). Constrain CHAIN_CTX to exactly that shape so a\n          # crafted workflow_dispatch input can't point cat at /proc/1/environ,\n          # ~/.gitlawb keys, or other secrets and read them into the prompt.\n          CHAIN_CTX=\"$CHAIN_CONTEXT_FILE\"\n          if [ -n \"$CHAIN_CTX\" ] && ! printf '%s' \"$CHAIN_CTX\" | grep -qE '^\\.outputs/\\.chain-context-[A-Za-z0-9._-]+\\.md$'; then\n            echo \"::error::Refusing chain_context_file outside .outputs/.chain-context-*.md: $CHAIN_CTX\"\n            exit 1\n          fi\n          if [ -n \"$CHAIN_CTX\" ] && [ -f \"$CHAIN_CTX\" ]; then\n            CONTEXT=$(cat \"$CHAIN_CTX\")\n            PROMPT=\"Today is $TODAY.\n\n          ## Context from prior chain steps\n          $CONTEXT\n\n          Read and execute the skill defined in skills/${SKILL_NAME}/SKILL.md\n          Use the chain context above instead of re-running those skills. Synthesize and build on their outputs.\"\n          else\n            PROMPT=\"Today is $TODAY. Read and execute the skill defined in skills/${SKILL_NAME}/SKILL.md\"\n          fi\n          if [ -n \"$VAR\" ]; then\n            PROMPT=\"$PROMPT\n\n          Use this variable (override the default in the skill file):\n          var=$VAR\"\n          fi\n          if ! CLAUDE_OUTPUT=$(echo \"$PROMPT\" | claude -p - \\\n            --model \"$MODEL\" --allowedTools \"$ALLOWED\" \\\n            --output-format json 2>&1); then\n            # $CLAUDE_OUTPUT is the combined stdout+stderr and can contain raw\n            # API response contents — never echo it in full to the public log.\n            # Log only a short, single-line tail (same redaction as the state file).\n            SNIPPET=$(echo \"$CLAUDE_OUTPUT\" | tail -c 500 | tr '\\n' ' ' | cut -c1-200)\n            echo \"::error::Claude CLI failed (truncated): $SNIPPET\"\n            # Save error signature for quality tracking (cron-state step reads this)\n            printf '%s' \"$SNIPPET\" > /tmp/skill-error.txt\n            exit 1\n          fi\n\n          RESULT_TEXT=$(echo \"$CLAUDE_OUTPUT\" | jq -r '.result // empty')\n          # Save the FULL result for the output-capture / chain / notify steps.\n          echo \"$RESULT_TEXT\" > /tmp/skill-result.txt\n          # Log only a bounded preview. The result can contain fetched or\n          # processed content (incl. sensitive data), so don't dump it all to the\n          # public Actions log — symmetric to the failure-path redaction above.\n          # The full result still flows downstream via /tmp/skill-result.txt.\n          printf '%s' \"$RESULT_TEXT\" | head -c 4000\n          if [ \"${#RESULT_TEXT}\" -gt 4000 ]; then\n            printf '\\n…[skill output truncated in log at 4000 chars; full result in artifact / notify]\\n'\n          else\n            printf '\\n'\n          fi\n\n          # Parse token usage from JSON response\n          INPUT_TOKENS=$(echo \"$CLAUDE_OUTPUT\" | jq '.usage.input_tokens // 0')\n          OUTPUT_TOKENS=$(echo \"$CLAUDE_OUTPUT\" | jq '.usage.output_tokens // 0')\n          CACHE_READ=$(echo \"$CLAUDE_OUTPUT\" | jq '.usage.cache_read_input_tokens // 0')\n          CACHE_CREATION=$(echo \"$CLAUDE_OUTPUT\" | jq '.usage.cache_creation_input_tokens // 0')\n          TOTAL_TOKENS=$((INPUT_TOKENS + OUTPUT_TOKENS))\n\n          echo \"SKILL_INPUT_TOKENS=$INPUT_TOKENS\" >> \"$GITHUB_OUTPUT\"\n          echo \"SKILL_OUTPUT_TOKENS=$OUTPUT_TOKENS\" >> \"$GITHUB_OUTPUT\"\n          echo \"SKILL_CACHE_READ_TOKENS=$CACHE_READ\" >> \"$GITHUB_OUTPUT\"\n          echo \"SKILL_CACHE_CREATION_TOKENS=$CACHE_CREATION\" >> \"$GITHUB_OUTPUT\"\n          echo \"SKILL_TOTAL_TOKENS=$TOTAL_TOKENS\" >> \"$GITHUB_OUTPUT\"\n\n          echo \"::notice::Token usage — input: $INPUT_TOKENS, output: $OUTPUT_TOKENS, cache_read: $CACHE_READ, cache_creation: $CACHE_CREATION, total: $TOTAL_TOKENS\""
                            },
                            "sourceLanguage": "yaml",
                            "startColumn": 27,
                            "startLine": 288
                          }
                        }
