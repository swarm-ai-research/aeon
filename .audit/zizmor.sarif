                            "endLine": 279,
                            "snippet": {
                              "text": "|\n          git config user.name \"aeonframework\"\n          git config user.email \"aeonframework@proton.me\"\n          git remote set-url origin \"https://x-access-token:${{ secrets.GITHUB_TOKEN }}@github.com/${{ github.repository }}.git\"\n\n          # Stage each path independently: `git add a b c` aborts and stages\n          # NOTHING if any pathspec is missing, so a not-yet-created optional\n          # dir would silently drop real updates (runner/generator state).\n          for p in \\\n            memory/gitlawb-runner/ \\\n            memory/instances.json \\\n            memory/gitlawb-deploy-proofs/ \\\n            memory/gitlawb-deployments/ \\\n            memory/gitlawb-deploy-state.json \\\n            memory/gitlawb-compute-futures-proofs/ \\\n            memory/gitlawb-metrics.jsonl \\\n            memory/fleet-task-generator-state.json \\\n            memory/fleet-goals/; do\n            git add \"$p\" 2>/dev/null || true\n          done\n          if git diff --staged --quiet; then\n            echo \"No changes to commit\"\n          else\n            git commit -m \"chore(fleet-runner): processed ${{ steps.runner.outputs.processed }} tasks, generated ${{ steps.generator.outputs.created }}\"\n            # Push runtime state to the fleet-state scratch branch, never main.\n            # The tree is main's code plus the full restored+updated state, so a\n            # force update keeps fleet-state a complete, current snapshot. On a\n            # rare race with a concurrent run, warn and let the next run refresh.\n            git push --force-with-lease origin HEAD:fleet-state \\\n              || echo \"::warning::fleet-state push raced with a concurrent run; state refreshes next run\"\n          fi"
                            },
                            "sourceLanguage": "yaml",
                            "startColumn": 65,
