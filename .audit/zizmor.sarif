                          "region": {
                            "endColumn": 81,
                            "endLine": 32,
                            "snippet": {
                              "text": "on:\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: \"Run mode\"\n        required: false\n        type: choice\n        default: \"once\"\n        options:\n          - once\n          - loop\n      agent:\n        description: \"Run only this agent (blank = all)\"\n        required: false\n        type: string\n      poll:\n        description: \"Poll interval in seconds (loop mode only)\"\n        required: false\n        default: \"30\"\n\n  schedule:\n    # Stretched from */15 to hourly after the docs/refactor/test-pass executors\n    # piled 100+ unmerged PRs onto the queue in a day. Combined with the\n    # in-executor backlog gate (GITLAWB_CODE_PASS_BACKLOG_LIMIT, default 3),\n    # this cuts PR churn ~4× without changing task semantics. workflow_dispatch\n    # is still available for ad-hoc runs that need immediate execution.\n    - cron: \"0 * * * *\"\n\n# Least-privilege: no permissions by default; the job grants only what it needs."
                            },
                            "sourceLanguage": "yaml",
                            "startColumn": 1,
                            "startLine": 4
                          }
                        }
                      }
